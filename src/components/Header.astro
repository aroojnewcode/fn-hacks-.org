---
import {
  getTranslations,
  localizePath,
  resolveLocale,
  type Locale,
} from '../i18n';
import { checkoutPath } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';
import type { IconName } from './icons/types';
import { PRODUCT_BASE } from '../config/site';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const t = getTranslations(locale);
const homeHref = localizePath(locale, '/');

const navIconsByHref: Record<string, IconName> = {
  '/': 'navFeatures',
  [PRODUCT_BASE]: 'navProducts',
  '/blog/': 'navBlog',
  '/forum/': 'messageCircle',
  '/faq/': 'navFaq',
  '/support/': 'navSupport',
};

const purchaseUrl = checkoutPath('fortnite');
const nav = t.nav.map((link) => {
  const bareHref = link.href;
  return {
    ...link,
    bareHref,
    href: localizePath(locale, bareHref),
    icon: (navIconsByHref[bareHref] ?? 'navFeatures') as IconName,
  };
});

const navLogoSrc = '/favicon-32.png';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="mx-auto w-full max-w-6xl px-5 pt-3 sm:pt-4" data-floating-nav>
    <div class="site-header-bar pointer-events-auto">
      <a
        href={homeHref}
        class="site-header-logo"
        aria-label={t.ui.homeAria}
      >
        <img
          src={navLogoSrc}
          alt=""
          width={36}
          height={36}
          class="site-header-logo__img"
          loading="eager"
          decoding="async"
        />
        <span class="site-header-logo__text" aria-hidden="true">
          Fortnite<span class="text-primary"> Hacks</span>
        </span>
      </a>

      <nav class="site-header-nav" aria-label="Primary">
        {nav.map((link) => (
          <a
            href={link.href}
            class="nav-link site-header-nav__link"
            data-nav-link
            {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
          >
            <Icon name={link.icon} size={15} class="site-header-nav__icon shrink-0" />
            <span class="site-header-nav__label">{link.label}</span>
          </a>
        ))}
      </nav>

      <div class="site-header-end">
        <div class="site-header-actions">
          <LanguageSwitcher locale={locale} class="shrink-0" />
          <SlideRevealButton
            href={purchaseUrl}
            class="site-header-cta hidden sm:inline-flex"
            ariaLabel={t.ui.checkoutAria}
          >
            {t.ui.browseCheats}
          </SlideRevealButton>
          <div class="nav-action-divider hidden h-9 items-center sm:flex" aria-hidden="true">
            <span class="block h-6 w-px bg-border"></span>
          </div>
          <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex shrink-0" />
        </div>

        <Sheet class="site-header-sheet">
          <SheetTrigger
            class="site-header-menu-btn"
            aria-label={t.ui.menuOpen}
          >
            <Icon name="menu" size={20} />
          </SheetTrigger>
          <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
            <SheetHeader>
              <SheetTitle>{t.site.name}</SheetTitle>
            </SheetHeader>
            <nav class="flex flex-col gap-1" aria-label="Mobile">
              {nav.map((link) => (
                <a
                  href={link.href}
                  class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
                  data-nav-link
                  {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                >
                  <Icon name={link.icon} size={16} />
                  {link.label}
                </a>
              ))}
            </nav>
            <div class="px-1">
              <LanguageSwitcher locale={locale} compact class="w-full" />
            </div>
            <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria}>
              {t.ui.browseCheatsMobile}
            </Button>
            <div class="flex justify-center pt-1">
              <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
            </div>
          </SheetContent>
        </Sheet>
      </div>
    </div>
  </div>
</header>
